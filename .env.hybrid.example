SOURCE__KIND=smb
SOURCE__SERVER=pers.local
SOURCE__SHARE=common
SOURCE__USERNAME=svc_indexer
SOURCE__PASSWORD=change-me
SOURCE__DOMAIN=
SOURCE__SUBPATH=Проекты
# Files in the subpath plus one nested folder: Проекты/file.docx and Проекты/Alpha/spec.pdf.
# Проекты/Alpha/docs/deep.pdf is skipped.
SOURCE__MAX_DEPTH=1
SOURCE__PORT=445
SOURCE__TIMEOUT_SEC=30
SOURCE__POLL_INTERVAL_SEC=15
SOURCE__STAGING_PATH=/data/staging-hybrid
SOURCE__MAX_BACKOFF_SEC=60

QDRANT__URL=http://host.docker.internal:6333
QDRANT__COLLECTION=docs-hybrid
QDRANT__TIMEOUT_SEC=120
# Parent folder of the file is stored as payload.direction (Бухгалтерия/акт.docx → Бухгалтерия).
QDRANT__INDEX_VERSION=hybrid-v3
CHUNKING__STRATEGY=hybrid

MODELS__OLLAMA_BASE_URL=http://host.docker.internal:11434
MODELS__EMBEDDING_MODEL=nomic-embed-text
MODELS__EMBEDDING_TIMEOUT_SEC=120
MODELS__CHUNK_SIZE=1024
MODELS__PICTURE_DESCRIPTION_ENABLED=true
MODELS__VLM_MODEL=qwen3-vl:8b
MODELS__VLM_TIMEOUT_SEC=90
MODELS__VLM_CONCURRENCY=2
MODELS__PICTURE_AREA_THRESHOLD=0.02

INDEX_EXTENSIONS=.txt,.md,.markdown,.rst,.log,.csv,.pdf,.docx,.pptx,.xlsx,.xls,.html,.htm
LOG_LEVEL=INFO
