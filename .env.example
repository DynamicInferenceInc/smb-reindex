SOURCE__KIND=smb
SOURCE__SERVER=fileserver
SOURCE__SHARE=docs
SOURCE__USERNAME=svc_indexer
SOURCE__PASSWORD=change-me
SOURCE__DOMAIN=CORP
SOURCE__SUBPATH=
SOURCE__PORT=445
SOURCE__TIMEOUT_SEC=30
SOURCE__POLL_INTERVAL_SEC=15
SOURCE__STAGING_PATH=/data/staging
SOURCE__MAX_BACKOFF_SEC=60

QDRANT__URL=http://host.docker.internal:6333
QDRANT__COLLECTION=docs-cv
QDRANT__INDEX_VERSION=resume-v20
CHUNKING__STRATEGY=resume_project
# One-shot audits (no embed, no Qdrant). Report: resume_report.csv/.txt next to the staging dir.
# RESUME_PARSE_ONLY=1
# RESUME_LLM_AUDIT=1

MODELS__OLLAMA_BASE_URL=http://host.docker.internal:11434
MODELS__EMBEDDING_MODEL=nomic-embed-text
MODELS__EMBEDDING_TIMEOUT_SEC=120
# DGX Spark: q8_0 fits in unified memory; fall back to qwen3.8:27b (Q4_K_M) if the tag is missing.
MODELS__EXTRACTION_MODEL=qwen3.8:27b-q8_0
MODELS__EXTRACTION_TIMEOUT_SEC=1800
MODELS__EXTRACTION_NUM_CTX=65536
MODELS__EXTRACTION_NUM_PREDICT=8192
MODELS__EXTRACTION_THINK=false
MODELS__CHUNK_SIZE=1024
MODELS__PICTURE_DESCRIPTION_ENABLED=false
MODELS__VLM_MODEL=qwen3-vl:8b
MODELS__VLM_TIMEOUT_SEC=90
MODELS__VLM_CONCURRENCY=2
MODELS__PICTURE_AREA_THRESHOLD=0.02

RESUME__LLM_PROJECTS=true
RESUME__LLM_REFINE=true
RESUME__LLM_EXPERIENCE=true
RESUME__RESIDUAL_MIN_CHARS=1500
RESUME__EVIDENCE_MIN_RATIO=0.85

INDEX_EXTENSIONS=.txt,.md,.markdown,.rst,.log,.csv,.pdf,.docx,.pptx,.xlsx,.xls,.html,.htm
LOG_LEVEL=INFO
